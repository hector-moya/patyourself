APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true
# Postgres migration path (swap DB_CONNECTION=pgsql, fill below):
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=patyourself
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` is the right local default — mail is written to storage/logs/laravel.log
# instead of sent. Reminder emails (SP7: per-cue + daily digest) require SES in
# every deployed environment; deploying with MAIL_MAILER=log ships silently —
# dispatchDue() reports success and digest_last_sent_on stamps, but the user
# never receives anything. Set MAIL_MAILER=ses (and fill AWS_* below) there.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS must be an SES-verified identity (a verified email address,
# or an address on a verified domain) — SES rejects sends from anything else.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are shared between S3 (if used) and
# SES (config/services.php `ses` block reuses these same two vars — there is no
# separate SES key). The IAM user/role behind them needs ses:SendRawEmail.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# LLM — server-side only, never expose to client.
# Provider credentials are read by config/ai.php (laravel/ai package).
# Model is set per-agent via #[Model] attributes; no global override needed.
ANTHROPIC_API_KEY=

# Cost guard: rolling-24h per-user token budget (0 disables). Over budget -> 429.
COACH_DAILY_TOKEN_BUDGET=200000
# Rate limit: coach requests per user per minute (0 disables).
COACH_RATE_PER_MINUTE=20
